# DocForge Environment Configuration

# Server
PORT=8080
DB_PATH=./docforge.db
UPLOAD_DIR=./uploads
DEV_MODE=true

# Security & Secrets (Must be 32 bytes / 64 hex chars for AES-256 GCM)
JWT_SECRET=docforge-production-super-secret-jwt-key-32-bytes
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Initial Seed Administrator
ADMIN_EMAIL=admin@docforge.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=System Administrator

# Atlassian Confluence OAuth 2.0 (3LO)
# Set MOCK_ATLASSIAN=false in production with registered Atlassian developer credentials
MOCK_ATLASSIAN=true
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:8080/api/v1/atlassian/callback
ATLASSIAN_SCOPES=read:me offline_access write:page:confluence read:page:confluence read:space:confluence write:confluence-content read:confluence-space.summary write:confluence-file read:confluence-content.all read:confluence-content.summary search:confluence readonly:content.attachment:confluence

# SMTP Email Notifications (optional - logs to console audit if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@docforge.local
